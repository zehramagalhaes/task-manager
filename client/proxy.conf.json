{
  "/api": {
    "target": "http://localhost:3000",
    "secure": false,
    "pathRewrite": {
      "^/api": "/api"
    },
    "changeOrigin": true,
    "logLevel": "debug"
  },
  "/auth": {
    "target": "http://localhost:3000",
    "secure": false,
    "pathRewrite": {
      "^/auth": "/api/auth"
    },
    "changeOrigin": true,
    "logLevel": "debug"
  }
}
