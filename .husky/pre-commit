#!/bin/sh
# Pre-commit hook — fast local quality gate that mirrors the CI pipeline.
# Runs: format + lint staged files → lint all → tests.
# Build is intentionally omitted — it's slow and CI handles it.
# Any step that fails will abort the commit (exit non-zero).
#
# NOTE: Uses #!/bin/sh (not #!/usr/bin/env sh) for Git Bash compatibility on
# Windows, where env may not be in PATH during hook execution.

set -e

# Ensure node_modules/.bin is on PATH so locally-installed binaries are found.
export PATH="$PWD/node_modules/.bin:$PATH"

echo "[pre-commit] Formatting & linting staged files..."
npx lint-staged

echo "[pre-commit] Linting — client & server..."
npm run lint

echo "[pre-commit] Testing — client & server..."
npm run test

echo "[pre-commit] All checks passed — committing."
